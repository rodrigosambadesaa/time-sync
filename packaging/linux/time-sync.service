[Unit]
Description=TimeSync validated NTP clock correction
Documentation=https://github.com/rodrigosambadesaa/time-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/time-sync/time-sync -mode sync -retry-window 45s
User=root
StateDirectory=time-sync
StateDirectoryMode=0755
CapabilityBoundingSet=CAP_SYS_TIME
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
