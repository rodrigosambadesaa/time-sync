<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rodrigosambadesaa.time-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/time-sync/time-sync</string>
    <string>-mode</string>
    <string>sync</string>
    <string>-retry-window</string>
    <string>45s</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- StartInterval misses interval firings while sleeping; launchd
       coalesces missed StartCalendarInterval firings on wake. -->
  <key>StartCalendarInterval</key>
  <array>
@CALENDAR_ENTRIES@
  </array>
</dict>
</plist>
